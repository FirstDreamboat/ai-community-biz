# ================= 数据库 =================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=opportunity
MYSQL_PASSWORD=opportunity123
MYSQL_DB=opportunity_system
DATABASE_URL=mysql+pymysql://opportunity:opportunity123@127.0.0.1:3306/opportunity_system?charset=utf8mb4

# ================= Redis =================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ================= AI（DeepSeek）=================
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_MODEL=deepseek-embedding

# ================= 安全 =================
JWT_SECRET=please-change-me-to-a-random-long-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ================= 推送 =================
# 三个渠道可只配需要的；留空则该渠道不启用（发送时标记 failed："渠道 webhook 地址未配置"）
PUSH_WEBHOOK_URL=          # 通用 webhook（系统 POST {type,title,content,sent_at} JSON）
PUSH_WECOM_WEBHOOK_URL=    # 企业微信群机器人：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
PUSH_DINGTALK_WEBHOOK_URL= # 钉钉群机器人：https://oapi.dingtalk.com/robot/send?access_token=xxx
PUSH_DINGTALK_SECRET=      # 钉钉加签密钥（SEC 开头，选"加签"安全方式时填，留空则用"自定义关键词"方式）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ================= 其他 =================
LOG_LEVEL=INFO
APP_ENV=dev
CORS_ORIGINS=*
